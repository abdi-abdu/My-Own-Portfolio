rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Project images: public read, admin write.
    match /projects/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Blog cover images: public read, admin write.
    match /blog/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
